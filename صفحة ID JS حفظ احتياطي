// pages/assessment/[id].js - النسخة المطورة (مع مقياس الثقة)
import { useState, useEffect } from 'react';
import { useRouter } from 'next/router';
import Link from 'next/link';
import { getAssessmentQuestions, getAssessmentName } from '../../data/questions/basics';

export default function Assessment() {
  const router = useRouter();
  const { id, mode } = router.query;

  const [questions, setQuestions] = useState([]);
  const [currentIndex, setCurrentIndex] = useState(0);
  const [answers, setAnswers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [showFeedback, setShowFeedback] = useState(false);
  const [lastAnswerCorrect, setLastAnswerCorrect] = useState(null);
  const [error, setError] = useState(null);
  const [writtenAnswer, setWrittenAnswer] = useState('');
  const [timePerQuestion, setTimePerQuestion] = useState([]);
  const [confidenceLevels, setConfidenceLevels] = useState([]);
  const [questionStartTime, setQuestionStartTime] = useState(Date.now());
  const [showConfidence, setShowConfidence] = useState(false);
  const [currentAnswerValue, setCurrentAnswerValue] = useState(null);

  const getQuestionLimit = () => {
    if (mode === 'quick') return 15;
    return 0;
  };

  useEffect(() => {
    if (id) {
      try {
        const assessmentQuestions = getAssessmentQuestions(id);
        if (!assessmentQuestions || assessmentQuestions.length === 0) {
          setError('لا توجد أسئلة لهذا التقييم');
          setLoading(false);
          return;
        }
        const shuffled = [...assessmentQuestions].sort(() => Math.random() - 0.5);
        const limit = getQuestionLimit();
        const limitedQuestions = limit > 0 ? shuffled.slice(0, limit) : shuffled;
        setQuestions(limitedQuestions);
        setLoading(false);
        setQuestionStartTime(Date.now());
      } catch (err) {
        console.error('Error loading assessment:', err);
        setError('حدث خطأ في تحميل التقييم');
        setLoading(false);
      }
    }
  }, [id, mode]);

  const handleAnswer = (selectedOption) => {
    if (!questions.length || showFeedback || showConfidence) return;
    const timeTaken = (Date.now() - questionStartTime) / 1000;
    setTimePerQuestion(prev => [...prev, timeTaken]);
    const currentQuestion = questions[currentIndex];
    let isCorrect = false;
    let answerValue = 0;
    if (currentQuestion.isWriting) {
      const userAnswer = writtenAnswer.trim().toLowerCase();
      const expected = currentQuestion.expectedAnswer?.toLowerCase() || '';
      isCorrect = userAnswer === expected;
      answerValue = isCorrect ? 1 : 0;
    } else {
      isCorrect = selectedOption === currentQuestion.correct;
      answerValue = selectedOption || 0;
    }
    setLastAnswerCorrect(isCorrect);
    setCurrentAnswerValue(answerValue);
    setShowConfidence(true);
  };

  const handleConfidence = (level) => {
    setConfidenceLevels(prev => [...prev, level]);
    const newAnswers = [...answers, currentAnswerValue];
    setAnswers(newAnswers);
    setShowConfidence(false);
    setShowFeedback(true);
  };

  const goToNextOrFinish = () => {
    setShowFeedback(false);
    setWrittenAnswer('');
    setQuestionStartTime(Date.now());
    setCurrentAnswerValue(null);
    if (currentIndex + 1 >= questions.length) {
      const answersString = JSON.stringify(answers);
      const questionsString = JSON.stringify(questions);
      const timeString = JSON.stringify(timePerQuestion);
      const confidenceString = JSON.stringify(confidenceLevels);
      router.push({
        pathname: '/result',
        query: {
          answers: answersString,
          questions: questionsString,
          assessmentId: id,
          total: questions.length,
          mode: mode || 'full',
          timePerQuestion: timeString,
          confidenceLevels: confidenceString,
        },
      });
      return;
    }
    setCurrentIndex(currentIndex + 1);
  };

  const progress = questions.length > 0 ? ((currentIndex) / questions.length) * 100 : 0;

  if (loading) {
    return (
      <div style={styles.loadingContainer}>
        <div style={styles.spinner}></div>
        <p>جاري تحميل التقييم...</p>
      </div>
    );
  }

  if (error) {
    return (
      <div style={styles.container}>
        <div style={styles.errorBox}>
          <h3>⚠️ {error}</h3>
          <p>يرجى العودة واختيار تقييم آخر.</p>
          <Link href="/assessment/categories" style={styles.backButton}>← العودة للتقييمات</Link>
        </div>
      </div>
    );
  }

  if (!questions.length || currentIndex >= questions.length) {
    return (
      <div style={styles.container}>
        <p>لا توجد أسئلة لهذا التقييم.</p>
        <Link href="/assessment/categories" style={styles.backButton}>← العودة لاختيار التقييم</Link>
      </div>
    );
  }

  const currentQuestion = questions[currentIndex];
  const assessmentName = getAssessmentName(id);
  const isQuick = mode === 'quick';

  const getLevelLabel = (difficulty) => {
    const levels = { 1: '🟢 سهل', 2: '🟡 متوسط', 3: '🔴 صعب' };
    return levels[difficulty] || '🟢 سهل';
  };

  const confidenceOptions = [
    { level: 25, label: '🤔 غير متأكد', color: '#F39C12' },
    { level: 50, label: '📖 متأكد إلى حد ما', color: '#3498DB' },
    { level: 90, label: '💪 متأكد تماماً', color: '#2ECC71' },
  ];

  return (
    <div style={styles.container}>
      <div style={styles.header}>
        <Link href="/" style={styles.logo}>🧠 Smart Lab</Link>
        <Link href="/assessment/categories" style={styles.backButton}>← تغيير التقييم</Link>
      </div>

      <div style={styles.infoBar}>
        <div style={styles.levelBadge}>
          {isQuick ? '⚡ تقييم سريع' : '📊 تقييم شامل'} · {assessmentName}
        </div>
        <div style={styles.questionCounter}>
          السؤال {currentIndex + 1} من {questions.length}
        </div>
      </div>

      <div style={styles.progressContainer}>
        <div style={styles.progressBar}>
          <div style={{ ...styles.progressFill, width: `${progress}%` }} />
        </div>
      </div>

      <div style={styles.questionCard}>
        <div style={styles.questionMeta}>
          <span style={styles.topicBadge}>{currentQuestion.topic || 'عام'}</span>
          <span style={styles.levelBadgeSmall}>{getLevelLabel(currentQuestion.difficulty)}</span>
          <span style={styles.cognitiveBadge}>{currentQuestion.cognitiveLevel || 'تذكر'}</span>
          {currentQuestion.isWriting && <span style={styles.writingBadge}>✏️ كتابي</span>}
        </div>

        <h2 style={styles.questionText}>{currentQuestion.question}</h2>

        {showConfidence && (
          <div style={styles.confidenceContainer}>
            <p style={styles.confidenceQuestion}>ما مدى ثقتك في إجابتك؟</p>
            <div style={styles.confidenceButtons}>
              {confidenceOptions.map((opt) => (
                <button key={opt.level} onClick={() => handleConfidence(opt.level)}
                  style={{ ...styles.confidenceButton, borderColor: opt.color, color: opt.color }}>
                  <span style={styles.confidenceIcon}>{opt.label.split(' ')[0]}</span>
                  <span>{opt.label}</span>
                </button>
              ))}
            </div>
            <p style={styles.confidenceHint}>هذا يساعدنا في تحليل أخطائك بدقة أكبر</p>
          </div>
        )}

        {showFeedback && (
          <div style={lastAnswerCorrect ? styles.feedbackCorrect : styles.feedbackWrong}>
            {lastAnswerCorrect ? (
              <span>✅ إجابة صحيحة!</span>
            ) : (
              <div>
                <span>❌ إجابة خاطئة</span>
                {currentQuestion.isWriting && (
                  <p style={styles.expectedAnswer}>الإجابة المتوقعة: <strong>{currentQuestion.expectedAnswer}</strong></p>
                )}
              </div>
            )}
            <button onClick={goToNextOrFinish} style={styles.nextButton}>
              {currentIndex + 1 >= questions.length ? '📊 عرض النتيجة' : '➡️ السؤال التالي'}
            </button>
          </div>
        )}

        {!showConfidence && !showFeedback && (
          <>
            {currentQuestion.isWriting ? (
              <div style={styles.writingContainer}>
                <textarea style={styles.writingInput} value={writtenAnswer}
                  onChange={(e) => setWrittenAnswer(e.target.value)} placeholder="اكتب إجابتك هنا..." rows={4} />
                <button onClick={() => handleAnswer(null)} disabled={!writtenAnswer.trim()}
                  style={{ ...styles.submitWritingButton, opacity: !writtenAnswer.trim() ? 0.5 : 1, cursor: !writtenAnswer.trim() ? 'not-allowed' : 'pointer' }}>
                  إرسال الإجابة
                </button>
              </div>
            ) : (
              <div style={styles.optionsContainer}>
                {currentQuestion.options.map((option, idx) => (
                  <button key={idx} onClick={() => handleAnswer(idx + 1)} style={styles.optionButton}>
                    {option}
                  </button>
                ))}
              </div>
            )}
          </>
        )}
      </div>

      {isQuick && (
        <div style={styles.quickInfo}>
          ⚡ تقييم سريع: {questions.length} سؤال فقط. ركز على الإجابات الصحيحة!
        </div>
      )}

      <div style={styles.infoBox}>💡 <strong>{assessmentName}</strong> - {questions.length} سؤالاً</div>
    </div>
  );
}

const styles = {
  container: { minHeight: '100vh', backgroundColor: '#f5f5f5', direction: 'rtl', fontFamily: 'system-ui, sans-serif', padding: '1rem' },
  header: { display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '1rem 2rem', backgroundColor: '#0D1E3B', color: 'white', borderRadius: '12px', marginBottom: '1.5rem' },
  logo: { fontSize: '1.5rem', fontWeight: 'bold', color: 'white', textDecoration: 'none' },
  backButton: { color: 'white', textDecoration: 'none', padding: '0.5rem 1rem', backgroundColor: '#2ECC71', borderRadius: '8px', display: 'inline-block' },
  errorBox: { backgroundColor: '#FFEBEE', padding: '2rem', borderRadius: '16px', textAlign: 'center', border: '1px solid #FFCDD2' },
  infoBar: { display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem', flexWrap: 'wrap', gap: '0.5rem' },
  levelBadge: { padding: '8px 16px', backgroundColor: '#E5CCB3', borderRadius: '20px', fontSize: '14px', fontWeight: 'bold' },
  questionCounter: { fontSize: '14px', color: '#666', fontWeight: 'bold', backgroundColor: 'white', padding: '6px 14px', borderRadius: '20px', boxShadow: '0 1px 4px rgba(0,0,0,0.05)' },
  progressContainer: { marginBottom: '1.5rem' },
  progressBar: { height: '10px', backgroundColor: '#ddd', borderRadius: '5px', overflow: 'hidden' },
  progressFill: { height: '100%', backgroundColor: '#2ECC71', transition: 'width 0.5s ease' },
  questionCard: { backgroundColor: '#F4F0E8', padding: '2rem', borderRadius: '16px', boxShadow: '0 4px 12px rgba(0,0,0,0.1)' },
  questionMeta: { display: 'flex', gap: '0.5rem', flexWrap: 'wrap', marginBottom: '1rem' },
  topicBadge: { display: 'inline-block', backgroundColor: '#0D1E3B', color: 'white', padding: '4px 14px', borderRadius: '20px', fontSize: '12px' },
  levelBadgeSmall: { display: 'inline-block', backgroundColor: '#6c757d', color: 'white', padding: '4px 12px', borderRadius: '20px', fontSize: '11px' },
  cognitiveBadge: { display: 'inline-block', backgroundColor: '#17a2b8', color: 'white', padding: '4px 12px', borderRadius: '20px', fontSize: '11px' },
  writingBadge: { display: 'inline-block', backgroundColor: '#FF9800', color: 'white', padding: '4px 12px', borderRadius: '20px', fontSize: '11px' },
  questionText: { fontSize: '1.3rem', marginBottom: '1.5rem', color: '#203565' },
  optionsContainer: { display: 'flex', flexDirection: 'column', gap: '0.75rem' },
  optionButton: { padding: '1rem', borderRadius: '10px', border: '2px solid #ddd', backgroundColor: 'white', cursor: 'pointer', textAlign: 'right', fontSize: '1rem', transition: 'all 0.3s', fontFamily: 'inherit' },
  confidenceContainer: { marginTop: '1rem', padding: '1.5rem', backgroundColor: '#F8F9FA', borderRadius: '12px', border: '2px dashed #9B59B6', textAlign: 'center' },
  confidenceQuestion: { fontSize: '1.1rem', fontWeight: 'bold', color: '#333', marginBottom: '1rem' },
  confidenceButtons: { display: 'flex', gap: '0.75rem', justifyContent: 'center', flexWrap: 'wrap' },
  confidenceButton: { display: 'flex', flexDirection: 'column', alignItems: 'center', padding: '1rem 1.5rem', borderRadius: '12px', border: '2px solid #ddd', backgroundColor: 'white', cursor: 'pointer', transition: 'all 0.2s', minWidth: '120px', fontFamily: 'inherit', fontSize: '0.9rem' },
  confidenceIcon: { fontSize: '1.5rem', marginBottom: '0.25rem' },
  confidenceHint: { fontSize: '0.75rem', color: '#999', marginTop: '0.75rem' },
  feedbackCorrect: { marginTop: '1rem', padding: '1.5rem', backgroundColor: '#E8F5E9', borderRadius: '10px', color: '#2E7D32', borderRight: '4px solid #2ECC71', textAlign: 'center' },
  feedbackWrong: { marginTop: '1rem', padding: '1.5rem', backgroundColor: '#FFEBEE', borderRadius: '10px', color: '#C62828', borderRight: '4px solid #E74C3C', textAlign: 'center' },
  expectedAnswer: { fontSize: '0.9rem', marginTop: '0.5rem', color: '#333' },
  nextButton: { marginTop: '1rem', padding: '0.75rem 2rem', backgroundColor: '#0D1E3B', color: 'white', border: 'none', borderRadius: '8px', fontSize: '1rem', cursor: 'pointer', fontFamily: 'inherit', transition: 'background-color 0.2s' },
  writingContainer: { marginTop: '1rem' },
  writingInput: { width: '100%', padding: '1rem', borderRadius: '10px', border: '2px solid #ddd', fontSize: '1rem', fontFamily: 'inherit', resize: 'vertical', minHeight: '120px', backgroundColor: 'white' },
  submitWritingButton: { marginTop: '0.75rem', padding: '0.75rem 2rem', backgroundColor: '#0D1E3B', color: 'white', border: 'none', borderRadius: '8px', fontSize: '1rem', cursor: 'pointer', transition: 'background-color 0.2s' },
  quickInfo: { backgroundColor: '#FFF8E1', padding: '0.75rem 1rem', borderRadius: '8px', textAlign: 'center', marginTop: '1rem', border: '1px solid #FFE082', fontSize: '0.9rem', color: '#E65100' },
  infoBox: { marginTop: '1.5rem', padding: '1rem', backgroundColor: '#E5CCB3', borderRadius: '10px', textAlign: 'center', fontSize: '14px', color: '#203565' },
  loadingContainer: { minHeight: '100vh', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: '1rem' },
  spinner: { width: '40px', height: '40px', border: '4px solid #ddd', borderTop: '4px solid #0D1E3B', borderRadius: '50%', animation: 'spin 1s linear infinite' },
};

if (typeof document !== 'undefined') {
  const style = document.createElement('style');
  style.textContent = '@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }';
  document.head.appendChild(style);
}
