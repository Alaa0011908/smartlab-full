# SmartLab Environment Configuration
# DO NOT include real secrets in this file.

# ==========================================
# CLIENT-SAFE VARIABLES (Available to Browser)
# ==========================================
# (Currently none required for core UI logic)

# ==========================================
# SERVER-ONLY VARIABLES (Never exposed to UI)
# ==========================================

# 1. LLM Provider Configuration
# Choose: 'deepseek' or 'mock' (Default is 'mock' if no key is provided)
LLM_PROVIDER=mock
# DEEPSEEK_API_KEY=your-api-key-here

# 2. Database (Supabase) Configuration - Required for Persistence
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
